        "type": "object",
        "properties": {
          "news_id": { "type": "integer" }
        },
        "required": ["news_id"]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "require_approval": true
    },
    {
      "name": "delete_news",
      "title": "Delete an article",
