      "input_schema": {
        "type": "object",
        "properties": {
          "news_id": { "type": "integer" }
        },
        "required": ["news_id"]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      },
