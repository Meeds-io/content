{
  "tools": [
    {
      "name": "create_news",
      "title": "Create an article",
      "description": "Create a news (Article) in the specified space.",
      "input_schema": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "html_content": { "type": "string" },
          "target_space_id": { "type": "integer" }
        },
        "required": ["title", "html_content", "target_space_id"]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "require_approval": true
    },
    {
      "name": "publish_news_in_activity_stream",
