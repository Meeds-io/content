<% def palette = org.exoplatform.commons.notification.mail.MailPalette.of(_templateContext) %>
<table border="0" cellpadding="0" cellspacing="0" width="600" bgcolor="${palette.surface}" align="center"
    style="background-color: ${palette.surface}; font-size: 13px;color:${palette.text};line-height: 18px;font-family: HelveticaNeue, Helvetica, Arial, sans-serif;"
	  xmlns="http://www.w3.org/1999/html" class="mail-surface mail-text">
	  <tr>
        <td align="center"  valign="middle" >
            <table  cellpadding="0" cellspacing="0" width="100%" bgcolor="${palette.surface}" align="center" style="border:1px solid ${palette.border};" class="mail-surface mail-border">
                <tr>
                    <td  height="45" valign="middle" style="margin:0;height:45px;font-weight:bold;vertical-align:middle;;background-color: ${palette.background};font-family: 'HelveticaNeue Bold', Helvetica, Arial, sans-serif;color:${palette.link};font-size:18px;text-align:center" class="mail-bg mail-link">
                        <% _ctx.include("war:/notification/templates/mail/NotificationLogo.gtmpl", _templateContext); %>
<a href="$ACTIVITY_LINK" style="text-decoration: none; color: ${palette.link}; font-family: 'HelveticaNeue Bold', Helvetica, Arial, sans-serif; font-size: 18px;" class="mail-link">
                            <%
                                def title = "";
                                switch(CONTEXT) {
                                    case "POST NEWS":
                                        title =  _ctx.appRes("news.notification.title",CONTENT_SPACE);
                                        break;
                                    case "MENTION IN NEWS":
                                        title = _ctx.appRes("news.notification.title.mention.in.news",CONTENT_TITLE);
                                        break;
                                    case "PUBLISH NEWS":
                                        title =  _ctx.appRes("news.notification.title.published.news");
                                        break;
                                    default:
                                        break;
                                }
                            %>
                            $title
                        </a>
						        </td>
                </tr>
				    </table>
        </td>
		</tr><!--end header area-->
    <tr>
        <td bgcolor="${palette.surface}" style="background-color: ${palette.surface};" class="mail-surface">
            <table cellpadding="0" cellspacing="0" width="100%"  bgcolor="${palette.surface}" style="background-color: ${palette.surface}; border-left:1px solid ${palette.border};border-right:1px solid ${palette.border};" class="mail-surface mail-border">
                <tr>
                    <td bgcolor="${palette.surface}" style="background-color: ${palette.surface};" class="mail-surface">
                        <table border="0" cellpadding="0" cellspacing="0" width="92%" bgcolor="${palette.surface}" align="center" style="background-color: ${palette.surface}; font-size: 13px;color:${palette.text};line-height: 18px;" class="mail-surface mail-text">
                            <tr>
                                <td align="left" bgcolor="${palette.surface}" style="background-color: ${palette.surface};padding: 20px 0 10px;" class="mail-surface">
                                    <p style="margin: 0 0 10px; color: ${palette.text}; font-size: 13px; line-height: 18px;" class="mail-text">
                                        <%=_ctx.appRes("Notification.label.SayHello")%> $FIRST_NAME,
                                    </p>
	                                  <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="${palette.surface}" align="center" style="background-color: ${palette.surface}; font-size: 13px;color:${palette.text};line-height: 18px;" class="mail-surface mail-text"><tbody><tr><td align="left" style="padding: 0;"><table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="${palette.surface}" align="center" style="width: 100%; background-color: ${palette.surface}; font-size: 13px; color:${palette.text};line-height: 18px;" class="mail-surface mail-text">
	                                      <tr>
	                                          <td align="left" valign="top" bgcolor="${palette.surface}" style="vertical-align: top; background-color: ${palette.surface}; padding: 0 15px 0 0;" class="mail-surface">
		                                            <a href="$ACTIVITY_LINK" style="margin: 4px 0 0; padding: 0; display: block;">
                                                    <img style="border-radius: 4px;" height="76" width="76" src="$AUTHOR_AVATAR_URL"/>
                                                </a>
																            </td>
                                            <td align="left" bgcolor="${palette.surface}" width="90%" align="top" style="width: 90%; background-color: ${palette.surface}; padding: 0 0; vertical-align: top;" class="mail-surface">
                                                <p style="margin: 0 0 10px; color: ${palette.text}; font-size: 13px; line-height: 18px;" class="mail-text">
                                                    <%
                                                        String spaceName = "<span style=\"font-weight: bold;\">" + CONTENT_SPACE + "</span>";
                                                        String creator = "<span style=\"color: ${palette.link}; font-weight: bold;\" class=\"mail-link\">" + CONTENT_AUTHOR + "</span>";
                                                        String currentUser = "<span style=\"color: ${palette.link}; font-weight: bold;\" class=\"mail-link\">" + CURRENT_USER + "</span>";
                                                        def notificationDescription = "";
                                                        switch(CONTEXT) {
                                                        case "POST NEWS":
                                                            notificationDescription =  _ctx.appRes("news.mailNotification.description",creator,CONTENT_TITLE,spaceName);
                                                            break;
                                                        case "MENTION IN NEWS":
                                                            notificationDescription =  _ctx.appRes("news.mailNotification.description.mention.in.news",CONTENT_TITLE);
                                                            break;
                                                        case "PUBLISH NEWS":
                                                            notificationDescription =  _ctx.appRes("news.mailNotification.description.publish.news", CURRENT_USER, CONTENT_TITLE);
                                                            break;
                                                        default:
                                                            break;
                                                        }

                                                    %>

                                                </p>
	                                              <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="${palette.background}" align="center" style="margin:0 0 10px; width: 100%; background-color: ${palette.background}; font-size: 13px; color:${palette.text};line-height: 18px;" class="mail-bg mail-text">
	                                                  <tr>
	                                                      <td align="left" valign="top" bgcolor="${palette.background}" style="vertical-align: top; background-color: ${palette.background}; padding: 10px 15px;" class="mail-bg">
	                                                          <p style="margin: 0 0 10px; color: ${palette.text}; font-size: 13px; line-height: 18px;" class="mail-text">
	                                                              <a href="#" style="text-decoration: none; color: ${palette.link}; font-family: 'HelveticaNeue Bold', Helvetica, Arial, sans-serif" class="mail-link">
                                                                </a>
                                                            </p>
                                                            <p style="margin: 0; color: ${palette.text}; font-size: 13px; line-height: 18px;" class="mail-text">
		                                                            <%=notificationDescription%>
                                                            </p>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td align="left" valign="top" bgcolor="${palette.surface}" style="vertical-align: top; background-color: ${palette.surface}; padding: 10px 0 0" class="mail-surface">
                                                            <p style="margin: 0">
                                                                <%
                                                                    def buttonLabel=_ctx.appRes("news.notification.button.goToContent.label");
                                                                %>
                                                                <a target="_blank" style="
                                                                    display: inline-block;
                                                                    text-decoration: none;
                                                                    font-size: 11px;
                                                                    font-family: HelveticaNeue, Helvetica, Arial, sans-serif,serif;
                                                                    color: ${palette.text};
                                                                    background-color: ${palette.background};;
                                                                    border-radius: 4px;
                                                                    -moz-border-radius: 4px;
                                                                    padding: 5px 8px;
                                                                    line-height: 100%;
                                                                    text-align: center;
                                                                    border: 1px solid ${palette.border};
                                                                    -webkit-box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                                                    -moz-box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                                                    box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(0,0,0,.05);
                                                                    vertical-align: middle;
                                                                    margin-left: 81%;
                                                                    " href="$ACTIVITY_LINK" target="_blank" class="mail-text mail-bg mail-border">
                                                                        $buttonLabel
                                                                </a>
                                                            </p>
																			                  </td>
                                                    </tr>
																	              </table>
                                            </td>
															          </tr>
                                    </table>
													      </td>
                            </tr>
                        </table>
										    <br>
                        <p style="margin: 0 0 10px; color: ${palette.secondaryText}; font-size: 13px; line-height: 18px;" class="mail-secondary-text">
                              <%=_ctx.appRes("news.notification.label.footer", "" + FOOTER_LINK).replace("class=\"notification_settings_url\"", "class=\"notification_settings_url mail-link\" style=\"color: ${palette.link};\"").replace("style=\"color: #2f5e92;", "class=\"mail-link\" style=\"color: ${palette.link};")%>
                        </p>
                    </td>
								</tr>
            </table>
				</td>
    </tr><!--end content area-->
    <% _ctx.include("war:/notification/templates/mail/NotificationFooter.gtmpl", _templateContext);%>

</table>
