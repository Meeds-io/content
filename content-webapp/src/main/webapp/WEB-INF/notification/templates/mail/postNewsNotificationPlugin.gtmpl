<table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" align="center" style="width:100%;overflow-wrap:anywhere;word-break:break-word;background-color: #ffffff; font-size: 15px;color: #1d2327;line-height: 1.7;font-family: ${io.meeds.portal.mail.util.EmailLayout.fontStack()};" dir="${io.meeds.portal.mail.util.EmailLayout.dir(_ctx.language)}">
<%
  def title = "";
  switch(CONTEXT) {
    case "POST NEWS":
      title = _ctx.appRes("news.notification.title", CONTENT_SPACE);
      break;
    case "MENTION IN NEWS":
      title = _ctx.appRes("news.notification.title.mention.in.news", CONTENT_TITLE);
      break;
    case "PUBLISH NEWS":
      title = _ctx.appRes("news.notification.title.published.news");
      break;
    default:
      break;
  }
  _templateContext.put("header_title", title);
  _ctx.include("war:/notification/templates/mail/NotificationHeader.gtmpl", _templateContext);
%>

  <%
  String spaceName = "<span style=\"color: ${io.meeds.portal.mail.util.EmailLayout.linkColor()}; text-decoration: none; font-weight: bold; font-family: ${io.meeds.portal.mail.util.EmailLayout.fontStack()}\">" + CONTENT_SPACE + "</span>";
  String creator = "<span style=\"color: ${io.meeds.portal.mail.util.EmailLayout.linkColor()}; text-decoration: none; font-weight: bold; font-family: ${io.meeds.portal.mail.util.EmailLayout.fontStack()}\">" + CONTENT_AUTHOR + "</span>";
  String currentUser = "<span style=\"color: ${io.meeds.portal.mail.util.EmailLayout.linkColor()}; text-decoration: none; font-weight: bold; font-family: ${io.meeds.portal.mail.util.EmailLayout.fontStack()}\">" + _ctx.escapeHTML(CURRENT_USER) + "</span>";
  String contentTitle = io.meeds.portal.mail.util.EmailLayout.entityStyled("<a href=\"" + ACTIVITY_LINK + "\">" + CONTENT_TITLE + "</a>");
  def notificationDescription = "";
  switch(CONTEXT) {
  case "POST NEWS":
  notificationDescription =  _ctx.appRes("news.mailNotification.description",creator,contentTitle,spaceName);
  break;
  case "MENTION IN NEWS":
  notificationDescription =  _ctx.appRes("news.mailNotification.description.mention.in.news",contentTitle);
  break;
  case "PUBLISH NEWS":
  notificationDescription =  _ctx.appRes("news.mailNotification.description.publish.news", currentUser, contentTitle);
  break;
  default:
  break;
  }

  %>
    <tr>
        <td style="padding:0 24px;">
            <table role="presentation" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" style="max-width:600px;margin:0 auto;background-color: #ffffff;">
                <tr>
                    <td bgcolor="#ffffff" style="background-color: #ffffff;">
                        <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" style="background-color: #ffffff; color: #1d2327;line-height: 1.7;">
                            <tr>
                                <td align="${io.meeds.portal.mail.util.EmailLayout.start(_ctx.language)}" style="padding: 30px 0 10px 0;">
                                    <p style="margin: 0 0 14px; font-size: 15px; color: #1d2327; font-family: ${io.meeds.portal.mail.util.EmailLayout.fontStack()};"><%=_ctx.appRes("Notification.label.SayHello")%> $FIRST_NAME,</p>
                                    <table border="0" cellpadding="0" cellspacing="0">
                                        <tr>
                                            <!--[if mso]>
                                                <td width="64" valign="top">
                                                    <img width="44" height="44" style="margin-top: 2px; border-radius: 50%;" src="$AUTHOR_AVATAR_URL" alt="" />
                                                </td>
                                            <![endif]-->
                                            <td width="64" valign="top" style="mso-hide:all; ">
                                                <img width="44" height="44" style="margin-top: 2px; border-radius: 50%;" src="$AUTHOR_AVATAR_URL" alt="" />
                                            </td>
                                            <td valign="top" dir="auto">
                                                <p style="margin:0 0 14px; color:#1d2327; line-height:1.7; font-size:15px; font-family: ${io.meeds.portal.mail.util.EmailLayout.fontStack()};" dir="auto"><%=notificationDescription%></p>
                                            </td>
                                        </tr>
                                    </table>
<div dir="${io.meeds.portal.mail.util.EmailLayout.dir(_ctx.language)}" style="margin: 20px 0 8px 0;">
                                                    <%=io.meeds.portal.mail.util.EmailLayout.actionLink(_ctx.appRes("news.notification.button.goToContent.label"), "$ACTIVITY_LINK", true)%>
                                                </div>
                                    <p style="margin:28px 0 0 0; color: #5d676d;font-size: 13px;font-family: ${io.meeds.portal.mail.util.EmailLayout.fontStack()}">
                                        <%=io.meeds.portal.mail.util.EmailLayout.linkStyled(_ctx.appRes("news.notification.label.footer", "" + FOOTER_LINK))%>
                                    </p>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr><!--end content area-->
    <% _ctx.include("war:/notification/templates/mail/NotificationFooter.gtmpl", _templateContext);%>
</table>
